generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  fullName    String
  password    String?  // Nullable: untuk fleksibilitas OAuth di masa depan
  avatarUrl   String?
  whatsappNumber String?
  role        Role     @default(USER)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adminProfile          AdminProfile?
  listingsAsSeller      Listing[]
  transactionsAsBuyer   Transaction[] @relation("BuyerTransactions")
  transactionsAsSeller  Transaction[] @relation("SellerTransactions")
  transactionsAsAdmin   Transaction[] @relation("AdminTransactions")
  reviewsGiven          Review[]      @relation("ReviewGiver")
  reviewsReceived       Review[]      @relation("ReviewReceiver")
  chatMessages          ChatMessage[]
  negotiationsAsBuyer   Negotiation[] @relation("NegotiationBuyer")
  negotiationsAsSeller  Negotiation[] @relation("NegotiationSeller")
  negotiationMessages   NegotiationMessage[]
  escrowTransfers       EscrowTransfer[]
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model AdminProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  bio          String?
  fee          Int
  bankAccounts Json
  activeHours  String?
  trustScore   Float    @default(0)
  responseTime Int?
  totalSuccess Int      @default(0)
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  title       String
  game        String        @default("eFootball")
  price       Int
  description String
  details     Json
  images      String[]
  status      ListingStatus @default(AVAILABLE)
  isFeatured  Boolean       @default(false)
  viewCount   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transactions Transaction[]
  negotiations Negotiation[]
}

enum ListingStatus {
  AVAILABLE
  IN_TRANSACTION
  SOLD
  INACTIVE
}

model Transaction {
  id          String            @id @default(cuid())
  negotiationId String?         @unique
  negotiation Negotiation?      @relation(fields: [negotiationId], references: [id])
  listingId   String
  listing     Listing           @relation(fields: [listingId], references: [id])
  buyerId     String
  buyer       User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId    String
  seller      User              @relation("SellerTransactions", fields: [sellerId], references: [id])
  adminId     String
  admin       User              @relation("AdminTransactions", fields: [adminId], references: [id])
  price       Int
  platformFee Int               @default(500)
  adminFee    Int               @default(1000)
  status      TransactionStatus @default(PENDING_PAYMENT)
  notes       String?
  disputeReason String?         // Disimpan di sini saat status = DISPUTED
  proofUrls   String[]
  logs        Json[]            // Timeline activity: [{action, actor, timestamp}]
  checklist   Json              // Legacy transaction checklist; no account secrets are collected by this flow
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  handoverStartedAt DateTime?
  handoverDeadlineAt DateTime?
  handoverPausedAt DateTime?
  adminJoinedAt DateTime?
  buyerWhatsapp String?
  sellerWhatsapp String?

  reviews      Review[]
  chatMessages ChatMessage[]
  payment      Payment?
  escrowTransfer EscrowTransfer?

  @@index([status, handoverDeadlineAt])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Negotiation {
  id String @id @default(cuid())
  listingId String
  listing Listing @relation(fields: [listingId], references: [id])
  buyerId String
  buyer User @relation("NegotiationBuyer", fields: [buyerId], references: [id])
  sellerId String
  seller User @relation("NegotiationSeller", fields: [sellerId], references: [id])
  offeredPrice Int?
  offerNotes String?
  offerStatus OfferStatus @default(PENDING)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages NegotiationMessage[]
  transaction Transaction?

  @@unique([listingId, buyerId])
  @@index([sellerId, updatedAt])
}

model NegotiationMessage {
  id String @id @default(cuid())
  negotiationId String
  negotiation Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  senderId String
  sender User @relation(fields: [senderId], references: [id])
  message String
  createdAt DateTime @default(now())

  @@index([negotiationId, createdAt])
}

enum EscrowTransferKind {
  SELLER_PAYOUT
  BUYER_REFUND
}

model EscrowTransfer {
  id String @id @default(cuid())
  transactionId String @unique
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  recipientId String
  recipient User @relation(fields: [recipientId], references: [id])
  kind EscrowTransferKind
  amount Int
  provider String @default("DUMMY")
  status String @default("SIMULATED")
  reference String @unique
  createdAt DateTime @default(now())
}

enum TransactionStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  IN_HANDOVER
  PENDING_BUYER_CONFIRM
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentProvider {
  MIDTRANS
}

enum PaymentMethod {
  QRIS
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  DENY
  CANCEL
  FAILURE
}

model Payment {
  id                    String          @id @default(cuid())
  transactionId         String          @unique
  transaction           Transaction     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  provider              PaymentProvider @default(MIDTRANS)
  method                PaymentMethod   @default(QRIS)
  status                PaymentStatus   @default(PENDING)
  orderId               String          @unique
  providerTransactionId String?         @unique
  providerPaymentType   String?
  amount                Int
  currency              String          @default("IDR")
  acquirer              String          @default("gopay")
  qrCodeUrl             String?
  expiresAt             DateTime?
  paidAt                DateTime?
  lastSyncedAt          DateTime?
  lastNotifiedAt        DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status])
  @@index([expiresAt])
}

model Review {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  giverId       String
  giver         User        @relation("ReviewGiver", fields: [giverId], references: [id])
  receiverId    String
  receiver      User        @relation("ReviewReceiver", fields: [receiverId], references: [id])
  rating        Int
  comment       String?
  type          ReviewType
  createdAt     DateTime    @default(now())
}

enum ReviewType {
  BUYER_TO_SELLER
  BUYER_TO_ADMIN
  SELLER_TO_ADMIN
}

model ChatMessage {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id])
  message       String
  createdAt     DateTime    @default(now())
}
